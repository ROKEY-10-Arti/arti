# cd로 들어오면 arti 환경을 켜고, 나가면 되돌린다
# 처음 한 번, 그리고 이 파일이 바뀔 때마다 `direnv allow` 필요

# 1) 로컬 환경변수 (ROS_DOMAIN_ID, 로봇 네임스페이스, ARTI_VENV 등)
source_env_if_exists env.bash

# 2) arti 전용 venv (없으면 `bash scripts/make_venv.sh`)
#    .bashrc에서 켠 다른 venv(rokey_venv)보다 앞에 오도록 PATH 맨 앞에 넣는다
ARTI_VENV="${ARTI_VENV:-$HOME/venvs/arti_venv}"
if [ -x "$ARTI_VENV/bin/python" ]; then
  export VIRTUAL_ENV="$ARTI_VENV"
  PATH_add "$ARTI_VENV/bin"
else
  log_error "arti venv 없음: bash scripts/make_venv.sh 실행"
fi

# 3) 빌드 결과
[ -f install/setup.bash ] && source install/setup.bash

watch_file install/setup.bash env.bash
