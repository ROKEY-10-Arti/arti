<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="flow" name="1. 전체 실행 흐름">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="890">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="1. 전체 실행 흐름" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontFamily=Noto Sans KR;fontColor=#263943;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1040" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="키오스크 초기 데이터 조회부터 Robot4 코스 관람·종료까지" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Noto Sans KR;fontColor=#263943;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="64" width="1040" height="24" as="geometry" />
        </mxCell>
        <mxCell id="runtime-heading" value="키오스크와 Robot4 실행 순서" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Noto Sans KR;fontColor=#263943;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="103" width="540" height="26" as="geometry" />
        </mxCell>
        <mxCell id="sources-heading" value="데이터 출처" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Noto Sans KR;fontColor=#263943;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="103" width="400" height="26" as="geometry" />
        </mxCell>
        <mxCell id="catalog" value="&lt;b&gt;키오스크 첫 로딩&lt;/b&gt;&lt;br&gt;GET /api/catalog → SQLite Art 및 이전 클라이언트용 courses&lt;br&gt;작품 선택 표에 제목·위치 코드·설명을 표시" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#f1f5e9;strokeColor=#789063;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="540" height="80" as="geometry" />
        </mxCell>
        <mxCell id="select" value="&lt;b&gt;관람객이 작품 선택 후 아티 호출&lt;/b&gt;&lt;br&gt;체크한 작품 ID로 POST /api/sessions&lt;br&gt;POST /api/sessions/&amp;lt;id&amp;gt;/preparation으로 관람 준비 요청" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#f1f5e9;strokeColor=#789063;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="540" height="80" as="geometry" />
        </mxCell>
        <mxCell id="prepare" value="&lt;b&gt;PC3 → PC2 · PrepareTour&lt;/b&gt;&lt;br&gt;/robot4/arti/prepare_tour {start: true}&lt;br&gt;Robot4 언독 → 만남 장소 이동 → 관람객 등록" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#e8f4ef;strokeColor=#5e907e;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="540" height="80" as="geometry" />
        </mxCell>
        <mxCell id="start" value="&lt;b&gt;PC3 → PC2 · StartTour 자동 요청&lt;/b&gt;&lt;br&gt;준비 성공 후 /robot4/arti/start_tour {artwork_ids: [1, 3, 4]}&lt;br&gt;수락되면 키오스크는 관람 안내를 표시한 뒤 첫 화면으로 복귀" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#e8f1fb;strokeColor=#6387af;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="540" height="80" as="geometry" />
        </mxCell>
        <mxCell id="tour" value="&lt;b&gt;Robot4 · 선택한 작품을 YAML 순서대로 관람&lt;/b&gt;&lt;br&gt;Nav2 이동 → 구역 안에서 정지 → 작품 해설 → 다음 작품&lt;br&gt;PC3가 ARTWORK_COMPLETED 피드백으로 방문 작품을 기록" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#e8f4ef;strokeColor=#5e907e;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="540" height="80" as="geometry" />
        </mxCell>
        <mxCell id="finish" value="&lt;b&gt;Robot4 · 출구 안내 후 도킹 복귀&lt;/b&gt;&lt;br&gt;관람 액션 결과를 PC3가 받아 TourSession에 반영" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#e8f4ef;strokeColor=#5e907e;" vertex="1" parent="1">
          <mxGeometry x="40" y="740" width="540" height="70" as="geometry" />
        </mxCell>
        <mxCell id="sqlite" value="&lt;b&gt;PC3 SQLite · Art&lt;/b&gt;&lt;br&gt;작품 ID, 위치 코드, 저장 좌표, 설명 등&lt;br&gt;오디오 노드는 /arti/description으로 설명을 조회&lt;br&gt;courses 프리셋은 기존 API 요청에 사용" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#fff5dc;strokeColor=#b28c4c;" vertex="1" parent="1">
          <mxGeometry x="680" y="140" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="floorplan" value="&lt;b&gt;키오스크 · gallery-map.js&lt;/b&gt;&lt;br&gt;안내용 평면도와 작품 표시 좌표" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#f1f5e9;strokeColor=#789063;" vertex="1" parent="1">
          <mxGeometry x="680" y="270" width="400" height="66" as="geometry" />
        </mxCell>
        <mxCell id="yaml" value="&lt;b&gt;PC2 · 로컬 YAML&lt;/b&gt;&lt;br&gt;a_course.yaml · 키오스크·작품 주행 목표와 구역&lt;br&gt;artworks.yaml · PC1과 공유하는 출구 구역" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#fff5dc;strokeColor=#b28c4c;" vertex="1" parent="1">
          <mxGeometry x="680" y="590" width="400" height="86" as="geometry" />
        </mxCell>
        <mxCell id="audio" value="&lt;b&gt;PC2 · guide_audio_node&lt;/b&gt;&lt;br&gt;시작 시 artworks.yaml의 작품별 음성 합성을 준비&lt;br&gt;해설마다 작품 번호로 설명을 다시 조회해 재생" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#fff5dc;strokeColor=#b28c4c;" vertex="1" parent="1">
          <mxGeometry x="680" y="714" width="400" height="82" as="geometry" />
        </mxCell>
        <mxCell id="catalog-select" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#637684;strokeWidth=1.5;fontSize=11;fontFamily=Noto Sans KR;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" source="catalog" target="select" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="select-prepare" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#637684;strokeWidth=1.5;fontSize=11;fontFamily=Noto Sans KR;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" source="select" target="prepare" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="prepare-start" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#637684;strokeWidth=1.5;fontSize=11;fontFamily=Noto Sans KR;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" source="prepare" target="start" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="start-tour" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#637684;strokeWidth=1.5;fontSize=11;fontFamily=Noto Sans KR;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" source="start" target="tour" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tour-finish" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#637684;strokeWidth=1.5;fontSize=11;fontFamily=Noto Sans KR;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" source="tour" target="finish" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sqlite-catalog" value="초기 조회" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#637684;strokeWidth=1.5;fontSize=11;fontFamily=Noto Sans KR;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" source="sqlite" target="catalog" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="floorplan-select" value="안내 지도" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#637684;strokeWidth=1.5;fontSize=11;fontFamily=Noto Sans KR;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" source="floorplan" target="select" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yaml-tour" value="좌표·구역" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#637684;strokeWidth=1.5;fontSize=11;fontFamily=Noto Sans KR;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" source="yaml" target="tour" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="tour-audio" value="ExplainArtwork" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#637684;strokeWidth=1.5;fontSize=11;fontFamily=Noto Sans KR;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.75;entryX=0;entryY=0.5;" source="tour" target="audio" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="630" y="680" />
              <mxPoint x="630" y="755" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="states" name="2. 상태 전이도">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="2. 상태 전이도" style="text;html=1;align=left;verticalAlign=middle;fontSize=25;fontFamily=Noto Sans KR;fontColor=#263943;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1040" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Robot4의 TourMachine 상태와 액션 진행 조건" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontFamily=Noto Sans KR;fontColor=#263943;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="64" width="1040" height="24" as="geometry" />
        </mxCell>
        <mxCell id="ready" value="&lt;b&gt;호출 대기&lt;/b&gt;&lt;br&gt;PrepareTour가 들어오면 출발 조건 확인 후 언독" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#e8f4ef;strokeColor=#5e907e;" vertex="1" parent="1">
          <mxGeometry x="380" y="110" width="360" height="65" as="geometry" />
        </mxCell>
        <mxCell id="nav-kiosk" value="&lt;b&gt;NAV_KIOSK → REGISTERING&lt;/b&gt;&lt;br&gt;키오스크 구역 정지 확인 → 관람객 등록" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#e8f4ef;strokeColor=#5e907e;" vertex="1" parent="1">
          <mxGeometry x="380" y="210" width="360" height="65" as="geometry" />
        </mxCell>
        <mxCell id="wait-start" value="&lt;b&gt;WAIT_START&lt;/b&gt;&lt;br&gt;PrepareTour 성공 반환 → StartTour 대기" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#e8f4ef;strokeColor=#5e907e;" vertex="1" parent="1">
          <mxGeometry x="380" y="310" width="360" height="65" as="geometry" />
        </mxCell>
        <mxCell id="art" value="&lt;b&gt;NAV_ARTWORK → EXPLAINING&lt;/b&gt;&lt;br&gt;정지 확인 후 해설, 완료 시 ARTWORK_COMPLETED" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#e8f4ef;strokeColor=#5e907e;" vertex="1" parent="1">
          <mxGeometry x="380" y="410" width="360" height="76" as="geometry" />
        </mxCell>
        <mxCell id="wait-visitor" value="&lt;b&gt;WAIT_VISITOR&lt;/b&gt;&lt;br&gt;관람객이 멀어지거나 놓치면 정지&lt;br&gt;가까워지면 이전 이동 목표로 재개" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#fff5dc;strokeColor=#b28c4c;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="275" height="76" as="geometry" />
        </mxCell>
        <mxCell id="exit" value="&lt;b&gt;NAV_EXIT → FAREWELL&lt;/b&gt;&lt;br&gt;출구 구역 정지 확인 → 종료 안내" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#e8f4ef;strokeColor=#5e907e;" vertex="1" parent="1">
          <mxGeometry x="380" y="530" width="360" height="65" as="geometry" />
        </mxCell>
        <mxCell id="return" value="&lt;b&gt;NAV_HOME → DOCKING&lt;/b&gt;&lt;br&gt;도킹 접근점으로 이동하고 Dock 실행&lt;br&gt;WAIT_DOCK_CONFIRM에서 도킹 상태 확인" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#e8f4ef;strokeColor=#5e907e;" vertex="1" parent="1">
          <mxGeometry x="380" y="650" width="360" height="78" as="geometry" />
        </mxCell>
        <mxCell id="done" value="&lt;b&gt;DONE&lt;/b&gt;&lt;br&gt;StartTour 결과 반환&lt;br&gt;정상 종료 시 success=true, message=completed" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#e8f4ef;strokeColor=#5e907e;" vertex="1" parent="1">
          <mxGeometry x="380" y="775" width="360" height="72" as="geometry" />
        </mxCell>
        <mxCell id="abort" value="&lt;b&gt;취소·시간 초과·이동 중 실패&lt;/b&gt;&lt;br&gt;등록 실패, 시작 시간 초과, 관람객 분실 등&lt;br&gt;종료 사유를 기록하고 도킹 복귀" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#faecec;strokeColor=#ab6767;" vertex="1" parent="1">
          <mxGeometry x="800" y="405" width="280" height="88" as="geometry" />
        </mxCell>
        <mxCell id="error" value="&lt;b&gt;ERROR&lt;/b&gt;&lt;br&gt;해설·복귀·도킹 실패 등에서 오류 결과 반환" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=13;fontFamily=Noto Sans KR;arcSize=12;fontColor=#263943;fillColor=#faecec;strokeColor=#ab6767;" vertex="1" parent="1">
          <mxGeometry x="800" y="650" width="280" height="78" as="geometry" />
        </mxCell>
        <mxCell id="ready-nav-kiosk" value="PrepareTour" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#637684;strokeWidth=1.5;fontSize=11;fontFamily=Noto Sans KR;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" source="ready" target="nav-kiosk" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nav-kiosk-wait-start" value="등록 완료" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#637684;strokeWidth=1.5;fontSize=11;fontFamily=Noto Sans KR;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" source="nav-kiosk" target="wait-start" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wait-start-art" value="StartTour" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#637684;strokeWidth=1.5;fontSize=11;fontFamily=Noto Sans KR;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" source="wait-start" target="art" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="art-exit" value="마지막 선택 작품 해설 완료" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#637684;strokeWidth=1.5;fontSize=11;fontFamily=Noto Sans KR;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" source="art" target="exit" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="exit-return" value="출구 안내 완료" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#637684;strokeWidth=1.5;fontSize=11;fontFamily=Noto Sans KR;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" source="exit" target="return" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="return-done" value="도킹 확인" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#637684;strokeWidth=1.5;fontSize=11;fontFamily=Noto Sans KR;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" source="return" target="done" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="art-wait-visitor" value="분실·거리 초과" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#637684;strokeWidth=1.5;fontSize=11;fontFamily=Noto Sans KR;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.72;entryX=1;entryY=0.72;" source="art" target="wait-visitor" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wait-visitor-art" value="재합류" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#637684;strokeWidth=1.5;fontSize=11;fontFamily=Noto Sans KR;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.28;entryX=0;entryY=0.28;" source="wait-visitor" target="art" edge="1" parent="1">
