# Arti 로컬 환경변수 — `cp env.bash.example env.bash` 후 각자 값 수정
# `ws arti` 할 때 자동으로 source 됨 (env.bash는 git에 올라가지 않음)

# 같은 네트워크의 다른 팀과 토픽이 섞이지 않게 팀 공통 값으로 맞춘다
export ROS_DOMAIN_ID=1          # 팀 공통 값 = 로봇 discovery 설정(/etc/turtlebot4_discovery/setup.bash)과 같음

# TurtleBot 4 두 대의 네임스페이스 (변수 이름의 1/2는 "첫째/둘째 로봇" 순서, 값이 실제 이름)
export ARTI_ROBOT1_NS=/robot1
export ARTI_ROBOT2_NS=/robot4

# PC 간 통신 (노션 "Multi Robot Custom Discovery Setup" CASE 1-3)
#   host  : 관제 PC. discovery server(ID 0)를 띄운다 → 별도 터미널에서 `bash scripts/run_discovery_server.sh`
#   guest : 로봇 PC(2대). 관제 PC에 붙는다 → ARTI_HOST_PC_IP에 Host PC의 `hostname -I` 값
#   빈 값 : PC 간 통신 없이 로봇만 (CASE 1-1)
# 팀 Host PC(서버 ID 0) = 192.168.107.54 (/etc/turtlebot4_discovery/setup.bash 0번 칸). 나머지 PC는 guest
export ARTI_PC_ROLE=guest
export ARTI_HOST_PC_IP=192.168.107.54   # guest일 때만 (Host PC의 `hostname -I`)

# 이 PC가 맡은 로봇의 discovery server "서버ID:IP" (scripts/ros_network.bash가 ROS_DISCOVERY_SERVER로 바꿈)
# CASE 1-3에서는 자기 로봇만 적는다. 서버 ID 0은 Host PC 자리라 쓰지 않는다.
#   robot1(follow) 담당: "1:192.168.107.101"
#   robot4(코스 관람) 담당: "4:<robot4 IP>"  (IP는 로봇 HMI 화면 맨 윗줄)
export ARTI_DISCOVERY_SERVERS="1:192.168.107.101"

# 이 PC가 맡은 로봇 네임스페이스 — 비워 두면 위 서버ID로 자동 (1 → /robot1, 4 → /robot4)
# launch의 namespace 기본값으로 쓰인다 (follow_test, person_tracker)
# export ARTI_ROBOT_NS=/robot1
