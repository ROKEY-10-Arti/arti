# Arti 로컬 환경변수 — `cp env.bash.example env.bash` 후 각자 값 수정
# `ws arti` 할 때 자동으로 source 됨 (env.bash는 git에 올라가지 않음)

# 같은 네트워크의 다른 팀과 토픽이 섞이지 않게 팀 공통 값으로 맞춘다
export ROS_DOMAIN_ID=1          # 팀 공통 값 = 로봇 discovery 설정(/etc/turtlebot4_discovery/setup.bash)과 같음

# TurtleBot 4 두 대의 네임스페이스 (변수 이름의 1/2는 "첫째/둘째 로봇" 순서, 값이 실제 이름)
export ARTI_ROBOT1_NS=/robot1
export ARTI_ROBOT2_NS=/robot4
