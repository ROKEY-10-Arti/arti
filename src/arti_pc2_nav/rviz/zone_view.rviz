Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 400
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Color: 100; 100; 100
      Value: true
    - Class: rviz_default_plugins/Map
      Name: 지도 (<map_ns>/map)
      Enabled: true
      Alpha: 0.7
      Color Scheme: map
      Topic:
        Value: <map_ns>/map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: 코스 구역·목표 (a_course.yaml)
      Enabled: true
      Namespaces:
        arti_pc2_zones: true
      Topic:
        Value: <robot_ns>/arti/a_course/zones
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: 로봇 (amcl_pose, 로봇이 떠 있을 때만)
      Enabled: true
      Covariance:
        Value: false
      Head Length: 0.12
      Head Radius: 0.08
      Shaft Length: 0.25
      Shaft Radius: 0.03
      Color: 0; 255; 0
      Shape: Arrow
      Topic:
        Value: <robot_ns>/amcl_pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: <robot_ns>/clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 110
      Target Frame: <Fixed Frame>
      X: -1.0
      Y: 2.0
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1200
  Displays:
    collapsed: false
