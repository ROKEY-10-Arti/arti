Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 400
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Color: 100; 100; 100
      Value: true
    - Class: rviz_default_plugins/Map
      Name: Map (localization)
      Enabled: true
      Alpha: 0.6
      Color Scheme: map
      Topic:
        Value: <ns>/map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: <ns>/robot_description
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR scan
      Enabled: true
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Size (m): 0.03
      Style: Flat Squares
      Topic:
        Value: <ns>/scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Value: true
    - Class: rviz_default_plugins/PointStamped
      Name: 인식 좌표 (point_map)
      Enabled: true
      Color: 255; 0; 255
      Radius: 0.12
      History Length: 1
      Topic:
        Value: <ns>/target_person/point_map
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Marker
      Name: 인식 모듈 사람 표시 (target_person/marker)
      Enabled: true
      Namespaces: ~
      Topic:
        Value: <ns>/target_person/marker
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/Image
      Name: 웹캠 (top_cam, 보기만 함)
      Enabled: true
      Normalize Range: true
      Topic:
        Value: <ns>/top_cam/image_raw/compressed
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: follow 판단 (follow/debug)
      Enabled: true
      Namespaces:
        follow: true
      Topic:
        Value: <ns>/follow/debug
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 120
      Target Frame: base_link
      X: 0
      Y: 0
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Height: 850
  Width: 1300
  Displays:
    collapsed: false
