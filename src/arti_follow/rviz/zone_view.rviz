Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Help Height: 0
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 400
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Color: 100; 100; 100
      Value: true
    - Class: rviz_default_plugins/Map
      Name: 지도 (<map_ns>/map)
      Enabled: true
      Alpha: 0.7
      Color Scheme: map
      Topic:
        Value: <map_ns>/map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Name: 구역 (artwork_zone/markers)
      Enabled: true
      Namespaces:
        artwork_zone: true
      Topic:
        Value: <map_ns>/artwork_zone/markers
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/PointStamped
      Name: 관람객 (target_person/point_map)
      Enabled: true
      Color: 255; 0; 255
      Radius: 0.12
      History Length: 1
      Topic:
        Value: <robot_ns>/target_person/point_map
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: 로봇 (amcl_pose)
      Enabled: true
      Covariance:
        Value: false
      Head Length: 0.12
      Head Radius: 0.08
      Shaft Length: 0.25
      Shaft Radius: 0.03
      Color: 0; 255; 0
      Shape: Arrow
      Topic:
        Value: <robot_ns>/amcl_pose
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR (scan)
      Enabled: true
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Size (m): 0.03
      Style: Flat Squares
      Topic:
        Value: <robot_ns>/scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Value: true
  Enabled: true
  Global Options:
    Background Color: 40; 40; 40
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: <robot_ns>/clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Angle: 0
      Scale: 110
      Target Frame: <Fixed Frame>
      X: -1.27
      Y: 2.4
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1200
  Displays:
    collapsed: false
