# 작품 설명 음성 재생 (로봇 PC 안: artwork_zone → guide_audio_node). 설명 문장은 PC3 /arti/description에서 받는다.
# 취소하면 0.3초 안에 멈춘다 (합성·재생 중 모두). 안내 음성(guide_message)이 오면 설명은 끊긴다(preempted).

# --- goal ---
int32 artwork_id           # 작품 번호 (arti_common artworks.yaml의 artwork_id, 예: 1)
                           #   guide_audio_node가 이 번호로 PC3 /arti/description에 설명을 묻는다
---
# --- result ---
bool completed             # 끝까지 재생했으면 true
string reason              # done / canceled / preempted / no_artwork(PC3에 없는 작품) /
                           #   no_description(PC3 응답 없음) / tts_error / player_error
---
# --- feedback ---
# (없음 — 받는 쪽이 결과만 본다)
