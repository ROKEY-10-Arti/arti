# 관람 시작 및 진행 (PC3 Client -> PC1/PC2 Server)
# 자유관람(Robot1): artwork_ids = []
# 코스관람(Robot4): artwork_ids = [1, 3, 4] 등
# 관람 종료는 Result, 취소는 Action Cancel로 처리

# Goal
int32[] artwork_ids   # 선택한 작품 ID 목록
---
# Result
bool success          # 관람 최종 성공 여부
string message        # 종료·실패 사유
---
# Feedback
string state          # MOVING | FOLLOW | EXPLAINING | ARTWORK_COMPLETED | RETURNING
int32 artwork_id      # 관련 작품 없으면 0
